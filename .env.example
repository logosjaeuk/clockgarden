# Required in production for canonical URLs and sitemap entries.
PUBLIC_SITE_URL=https://clockgarden.com

# Optional. Events are not transmitted when this is blank.
PUBLIC_ANALYTICS_ENDPOINT=

# Optional Search Console verification token.
PUBLIC_GOOGLE_SITE_VERIFICATION=

# Reserved integration switch. Keep false until a reviewed provider integration,
# privacy notice, consent flow, and production-domain validation are complete.
# No ad provider, publisher ID, or third-party script is bundled.
PUBLIC_ADS_ENABLED=false
