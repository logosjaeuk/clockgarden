---
import BaseLayout from '../layouts/BaseLayout.astro';
import type { ArticleCopy } from '../content/insights';
import type { Locale } from '../config';
import { pathFor } from '../i18n';
const { article, locale } = Astro.props as { article: ArticleCopy; locale: Locale };
const ko = locale === 'ko';
const path = '/insights/' + article.slug + '/';
const canonical = new URL(pathFor(locale, path), Astro.site).href;
const schema = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: article.title,
  description: article.description,
  datePublished: article.publishedDate,
  dateModified: article.modifiedDate,
  inLanguage: locale,
  mainEntityOfPage: canonical,
  author: {
    '@type': 'Organization',
    name: 'Clock Garden',
    url: new URL(pathFor(locale, '/about/'), Astro.site).href,
  },
  publisher: { '@type': 'Organization', name: 'Clock Garden', url: Astro.site?.href },
  citation: article.sources.map((source) => new URL(source.url, Astro.site).href),
};
---

<BaseLayout title={article.title} description={article.description} locale={locale} path={path}>
  <script slot="head" is:inline type="application/ld+json" set:html={JSON.stringify(schema)} />
  <article class="article-page">
    <a class="article-nav-back" href={pathFor(locale, '/insights/')}
      >{ko ? '← 사용 안내 목록' : '← All guides'}</a
    >
    <header class="article-header">
      <div class="insight-badge-row"><span class="insight-badge">{article.category}</span></div>
      <h1>{article.title}</h1>
      <div class="article-meta-row">
        <a href={pathFor(locale, '/about/')}>Clock Garden</a>
        <span
          >{ko ? '처음 게시' : 'Published'}
          <time datetime={article.publishedDate}>{article.publishedDate}</time></span
        >
        <span
          >{ko ? '수정' : 'Updated'}
          <time datetime={article.modifiedDate}>{article.modifiedDate}</time></span
        >
      </div>
    </header>
    <p class="article-lead">{article.heroLead}</p>
    {
      article.slug === 'behind-living-clock-crafting-digital-zen' && (
        <div class="scene-provenance">
          <figure>
            <>
              <img
                src="/scenes/moonlit-conservatory/thumbnail.webp"
                width="480"
                height="360"
                loading="lazy"
                alt={
                  ko ? '온실과 연못의 Blender 렌더' : 'Blender render of the conservatory and pond'
                }
              />
              <figcaption>
                {ko
                  ? '달빛 온실 · Blender 모델과 렌더'
                  : 'Moonlit Conservatory · Blender modeling and rendering'}
              </figcaption>
            </>
          </figure>
          <figure>
            <>
              <img
                src="/scenes/rainlight/thumbnail.webp"
                width="480"
                height="320"
                loading="lazy"
                alt={ko ? '비 오는 창가의 배경 일러스트' : 'Illustrated rainy window background'}
              />
              <figcaption>
                {ko
                  ? 'Rainlight · AI 생성 배경과 Canvas 효과'
                  : 'Rainlight · AI-generated background and canvas effects'}
              </figcaption>
            </>
          </figure>
          <figure>
            <>
              <img
                src="/scenes/quiet-study/thumbnail.webp"
                width="480"
                height="320"
                loading="lazy"
                alt={
                  ko
                    ? '탁상시계가 있는 공부방 일러스트'
                    : 'Study-room illustration with a desk clock'
                }
              />
              <figcaption>
                {ko
                  ? 'Quiet Study · 참고 그림의 AI 편집과 실시간 시계'
                  : 'Quiet Study · AI-edited reference and live clock'}
              </figcaption>
            </>
          </figure>
        </div>
      )
    }
    <nav class="article-toc" aria-label={ko ? '이 글의 목차' : 'On this page'}>
      <ol>
        {
          article.sections.map((section, index) => (
            <li>
              <a href={'#section-' + index}>{section.heading}</a>
            </li>
          ))
        }
      </ol>
    </nav>
    <div class="article-body">
      {
        article.sections.map((section, index) => (
          <section class="article-section" id={'section-' + index}>
            <h2>{section.heading}</h2>
            {section.paragraphs.map((paragraph) => (
              <p>{paragraph}</p>
            ))}
          </section>
        ))
      }
    </div>
    <section class="article-takeaways">
      <h2>{ko ? '사용 전 확인할 점' : 'Before you use it'}</h2>
      <ul>{article.takeaways.map((item) => <li>{item}</li>)}</ul>
    </section>
    <section class="article-section article-sources">
      <h2>{ko ? '참고 자료와 관련 도구' : 'References and related tools'}</h2>
      <ul>
        {
          article.sources.map((source) => (
            <li>
              <a href={source.url}>{source.label}</a>
            </li>
          ))
        }
      </ul>
      <p>
        {
          ko
            ? '도구 동작은 현재 구현을 기준으로 설명합니다. 오류가 있으면 문의 페이지로 알려주세요.'
            : 'Tool behavior is described from the current implementation. Please report corrections through the contact page.'
        }
        <a href={pathFor(locale, '/contact/')}>{ko ? '오류 제보' : 'Report a correction'}</a>
      </p>
    </section>
    <aside class="article-tool-cta">
      <p>
        {
          ko
            ? '설명한 설정을 실제 도구에서 확인해 보세요.'
            : 'Try the settings in the tool described above.'
        }
      </p>
      <a class="article-tool-btn" href={pathFor(locale, '/' + article.relatedTool + '/')}
        >{ko ? '도구 열기 →' : 'Open the tool →'}</a
      >
    </aside>
  </article>
</BaseLayout>
