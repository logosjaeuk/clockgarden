---
import type { Locale } from '../config';
import LivingClock from './LivingClock.astro';
import '../styles/living-clock.css';
interface Props {
  locale: Locale;
  heading?: string;
}
const { locale, heading } = Astro.props;
const ko = locale === 'ko';
const guide = ko
  ? [
      [
        'Living Clock · 등불섬',
        '하늘과 해·달은 기기 시간의 하루를, 산책로의 등불 60개는 분을 나타냅니다. 작은 배는 매분 항구를 한 바퀴 돌아 초를 보여 줍니다. 정각에는 물결이 퍼집니다. 섬의 하루 둘러보기로 다른 시간의 풍경을 20초 동안 미리 볼 수 있습니다. 실제 일출·일몰이나 달의 위상을 계산하는 기능은 아닙니다.',
      ],
      [
        '화면 켜두기',
        '이 페이지를 보고 있는 동안 화면이 자동으로 꺼지지 않도록 합니다. 책상 위 시계로 사용할 때 켜세요. 다시 누르면 해제됩니다. 다른 탭으로 이동하거나 기기를 잠그면 해제될 수 있으니 돌아왔을 때 켜짐 상태를 확인하세요. 지원되는 브라우저에서만 표시됩니다.',
      ],
      [
        '전체 화면',
        '메뉴와 주변 내용을 숨기고 시계를 화면 가득 표시합니다. 발표나 멀리서 시간을 볼 때 유용합니다. 전체 화면 종료 버튼이나 Esc 키로 돌아올 수 있습니다. 화면 켜두기는 별도로 켜야 합니다.',
      ],
      [
        '초 · 밀리초',
        '초 표시를 켜거나 끕니다. 밀리초를 켜면 초 아래 단위인 0.001초까지 표시합니다. 표시가 더 세밀해지는 기능이며 기기 시계의 정확도를 높이지는 않습니다.',
      ],
      [
        '12h · 24h',
        '버튼을 눌러 오전·오후가 있는 12시간제와 00~23시로 표시하는 24시간제 사이를 전환합니다.',
      ],
      [
        '아날로그',
        '숫자 시계 아래에 시침·분침·초침이 있는 바늘 시계를 함께 표시합니다. 다시 누르면 숨겨집니다.',
      ],
    ]
  : [
      [
        'Living Clock · Lantern Isle',
        'The sky, sun and moon follow your device’s 24-hour day. The promenade has 60 lanterns: one lights up each minute. A little ferry completes its harbor circuit every minute, showing the seconds. A quiet ripple marks the hour. Explore a day previews another time for 20 seconds. Sunrise, sunset and moon shape are artistic, not astronomical predictions.',
      ],
      [
        'Keep screen awake',
        'Prevents the screen from automatically turning off while you are viewing this page. Useful as a desk clock. Press again to release it. Switching tabs or locking your device may release it, so check the enabled state when you return. Shown only in supported browsers.',
      ],
      [
        'Fullscreen',
        'Hides menus and surrounding content so the clock fills your screen. Useful for presentations or viewing from a distance. Use Exit fullscreen or press Esc to return. Enable Keep screen awake separately if needed.',
      ],
      [
        'Seconds · Milliseconds',
        'Show or hide seconds. Milliseconds adds three decimal places, down to 0.001 seconds. This adds display detail; it does not improve the accuracy of your device clock.',
      ],
      ['12h · 24h', 'Switch between 12-hour time with AM/PM and 24-hour time from 00 to 23.'],
      [
        'Analog',
        'Shows a clock face with hour, minute and second hands below the digital time. Press again to hide it.',
      ],
    ];
---

<section class="instrument clock-instrument" data-tool="clock" data-locale={locale}>
  {heading && <h1 class="sr-only">{heading}</h1>}
  <LivingClock locale={locale} />
  <div class="clock-readout">
    <p class="instrument-kicker">{ko ? '현재 현지 시간' : 'Current local time'}</p>
    <div class="hero-time" data-clock-time aria-label={ko ? '현재 시간' : 'Current time'}>
      --:--:--
    </div>
    <p class="hero-date" data-clock-date>—</p>
    <p class="zone-line">
      <span data-clock-zone>—</span><span aria-hidden="true"> · </span><span data-clock-offset
        >—</span
      >
    </p>
    <p class="tool-note">
      {
        ko
          ? '기기 기준 시간 · 표준시 서버와 동기화되지 않음'
          : 'Device time · not synchronized to a time server'
      }
    </p>
  </div>
  <div class="control-row" aria-label={ko ? '시계 설정' : 'Clock settings'}>
    <button class="chip living-toggle" type="button" data-action="living" aria-pressed="false"
      >✦ Living Clock</button
    >
    <button class="chip is-active" type="button" data-action="seconds" aria-pressed="true"
      >{ko ? '초 켬' : 'Seconds on'}</button
    >
    <button class="chip" type="button" data-action="millis" aria-pressed="false"
      >{ko ? '밀리초 끔' : 'Milliseconds off'}</button
    >
    <button class="chip" type="button" data-action="hour-mode">24h</button>
    <button class="chip" type="button" data-action="analog" aria-pressed="false"
      >{ko ? '아날로그' : 'Analog'}</button
    >
    <button class="chip" type="button" data-action="wake" aria-pressed="false" hidden
      >{ko ? '화면 켜두기' : 'Keep screen awake'}</button
    >
    <button class="chip" type="button" data-action="fullscreen"
      >{ko ? '전체 화면' : 'Fullscreen'}</button
    >
  </div>
  <details class="clock-guide">
    <summary
      >{ko ? '사용 가이드 · 버튼별 기능 알아보기' : 'Quick guide · What each button does'}</summary
    >
    <dl>
      {
        guide.map(([title, description]) => (
          <div>
            <>
              <dt>{title}</dt>
              <dd>{description}</dd>
            </>
          </div>
        ))
      }
    </dl>
  </details>
  <div class="analog-wrap" data-analog-wrap hidden>
    <div
      class="analog-clock"
      role="img"
      aria-label={ko
        ? '현재 시간을 표시하는 아날로그 시계'
        : 'Analog clock showing the current time'}
    >
      <span class="hand hour-hand" data-hour-hand></span><span
        class="hand minute-hand"
        data-minute-hand></span><span class="hand second-hand" data-second-hand></span><span
        class="pin"></span>
    </div>
  </div>
  <p class="status-line" data-status aria-live="polite"></p>
</section>
