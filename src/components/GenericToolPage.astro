---
import BaseLayout from '../layouts/BaseLayout.astro';
import ClockTool from './ClockTool.astro';
import StopwatchTool from './StopwatchTool.astro';
import TimerTool from './TimerTool.astro';
import AlarmTool from './AlarmTool.astro';
import WorldClockTool from './WorldClockTool.astro';
import ConverterTool from './ConverterTool.astro';
import AdSlot from './AdSlot.astro';
import { toolPages, type ToolKey } from '../content/toolPages';
import type { Locale } from '../config';

const { locale, tool } = Astro.props as { locale: Locale; tool: ToolKey };
const page = toolPages[locale][tool];
const components = {
  clock: ClockTool,
  stopwatch: StopwatchTool,
  timer: TimerTool,
  alarm: AlarmTool,
  'world-clock': WorldClockTool,
  'time-zone-converter': ConverterTool,
};
const Tool = components[tool];

const faqTitle = locale === 'ko' ? '자주 묻는 질문 (FAQ)' : 'Frequently Asked Questions';
const shortcutsTitle = locale === 'ko' ? '키보드 조작 단축키' : 'Keyboard Shortcuts';

const faqSchema =
  page.faqs && page.faqs.length > 0
    ? {
        '@context': 'https://schema.org',
        '@type': 'FAQPage',
        mainEntity: page.faqs.map((f) => ({
          '@type': 'Question',
          name: f.question,
          acceptedAnswer: {
            '@type': 'Answer',
            text: f.answer,
          },
        })),
      }
    : null;
---

<BaseLayout title={page.title} description={page.meta} locale={locale} path={`/${tool}/`} tool>
  {
    faqSchema && (
      <script
        slot="head"
        is:inline
        type="application/ld+json"
        set:html={JSON.stringify(faqSchema)}
      />
    )
  }

  <article class="tool-page">
    <header class="tool-heading">
      <p class="eyebrow">{page.eyebrow}</p>
      <h1>{page.heading}</h1>
    </header>

    <Tool locale={locale} />

    {
      page.shortcuts && page.shortcuts.length > 0 && (
        <section class="shortcuts-panel" aria-label={shortcutsTitle}>
          <h2 class="shortcuts-heading">{shortcutsTitle}</h2>
          <div class="shortcuts-grid">
            {page.shortcuts.map((sc) => (
              <div class="shortcut-item">
                <kbd class="shortcut-key">{sc.key}</kbd>
                <span class="shortcut-action">{sc.action}</span>
              </div>
            ))}
          </div>
        </section>
      )
    }

    <p class="tool-summary">{page.intro}</p>

    <div class="supporting-copy">
      {
        page.sections.map((section) => (
          <section class="guide-section">
            <h2>{section.heading}</h2>
            <p>{section.body}</p>
            {section.list && section.list.length > 0 && (
              <ul class="guide-list">
                {section.list.map((item) => (
                  <li>{item}</li>
                ))}
              </ul>
            )}
          </section>
        ))
      }
    </div>

    {
      page.faqs && page.faqs.length > 0 && (
        <section class="faq-container" aria-label={faqTitle}>
          <div class="faq-header">
            <p class="eyebrow">{locale === 'ko' ? '질문과 답변' : 'Questions & Answers'}</p>
            <h2>{faqTitle}</h2>
          </div>
          <div class="faq-list">
            {page.faqs.map((faq) => (
              <details class="faq-item">
                <summary class="faq-question">
                  <span>{faq.question}</span>
                  <span class="faq-chevron" aria-hidden="true">
                    ▾
                  </span>
                </summary>
                <div class="faq-answer">
                  <p>{faq.answer}</p>
                </div>
              </details>
            ))}
          </div>
        </section>
      )
    }

    <AdSlot locale={locale} />
  </article>

  <script>
    import '../scripts/tools';
  </script>
</BaseLayout>
