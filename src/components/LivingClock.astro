---
import type { Locale } from '../config';
const { locale } = Astro.props as { locale: Locale };
const ko = locale === 'ko';
---

<div class="living-world" data-living-world hidden>
  <canvas data-living-canvas aria-hidden="true"></canvas>
  <div class="word-clock" hidden data-word-clock>
    <svg viewBox="0 0 400 400" aria-hidden="true"
      ><circle cx="200" cy="200" r="190" class="word-track"></circle><circle
        cx="200"
        cy="200"
        r="190"
        pathLength="60"
        class="word-progress"></circle></svg
    >
    <div class="word-face">
      <span data-word-period></span><strong data-word-hour></strong><span data-word-minute
      ></span><small>{ko ? '지금, 이 순간' : 'HERE, NOW'}</small>
    </div>
  </div>
  <details class="living-scenes">
    <summary>{ko ? '풍경 선택' : 'Scenes'}</summary>
    <div>
      <button type="button" data-scene="words" aria-pressed="false"
        >{ko ? '격자 시계' : 'Word Clock'}</button
      >
      <button type="button" data-scene="isle" aria-pressed="true">Lantern Isle</button>
      <button type="button" data-scene="aquarium" aria-pressed="false"
        >{ko ? '심해 수족관' : 'Deep Aquarium'}</button
      >
    </div>
  </details>
  <div class="living-heading">
    <span class="living-wordmark">LANTERN ISLE</span>
    <span class="living-phase" data-living-phase></span>
  </div>
  <div class="living-preview-state" data-living-preview hidden role="status">
    <span>{ko ? '하루 미리보기 · 실제 시간이 아닙니다' : 'Day preview · not the current time'}</span
    >
    <button type="button" data-living-live>{ko ? '현재 시간으로' : 'Back to live'}</button>
  </div>
  <div class="living-bottom">
    <div class="living-legend" aria-label={ko ? '풍경으로 시간 읽기' : 'Read the landscape'}>
      <span
        ><i class="legend-sky" aria-hidden="true"></i><b>{ko ? '하늘' : 'Sky'}</b><small
          >{ko ? '하루 24시간' : 'a 24-hour day'}</small
        ></span
      >
      <span
        ><i class="legend-lantern" aria-hidden="true"></i><b>{ko ? '등불' : 'Lanterns'}</b><small
          data-living-minutes></small></span
      >
      <span
        ><i class="legend-boat" aria-hidden="true"></i><b>{ko ? '작은 배' : 'Little ferry'}</b
        ><small data-living-seconds></small></span
      >
    </div>
    <details class="living-explore">
      <summary>{ko ? '섬의 하루 둘러보기' : 'Explore a day on the island'}</summary>
      <div class="living-presets">
        <button type="button" data-living-hour="6">{ko ? '새벽' : 'Dawn'}</button>
        <button type="button" data-living-hour="12">{ko ? '한낮' : 'Noon'}</button>
        <button type="button" data-living-hour="18">{ko ? '노을' : 'Dusk'}</button>
        <button type="button" data-living-hour="0">{ko ? '한밤' : 'Midnight'}</button>
      </div>
      <p>
        {
          ko
            ? '20초 동안 미리 본 뒤 현재 시간으로 돌아옵니다.'
            : 'A 20-second visit, then back to the present.'
        }
      </p>
    </details>
  </div>
</div>
