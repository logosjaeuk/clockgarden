---
import type { Locale } from '../config';
const { locale } = Astro.props as { locale: Locale };
const ko = locale === 'ko';
---

<section class="instrument" data-tool="stopwatch" data-locale={locale}>
  <div class="hero-time stopwatch-time" data-stopwatch-time role="timer">00:00:00.000</div>
  <div class="primary-controls">
    <button class="button primary" type="button" data-action="start">{ko ? '시작' : 'Start'}</button
    >
    <button class="button" type="button" data-action="lap" disabled>{ko ? '랩' : 'Lap'}</button>
    <button class="button" type="button" data-action="reset" disabled
      >{ko ? '초기화' : 'Reset'}</button
    >
    <button class="button quiet" type="button" data-action="fullscreen"
      >{ko ? '전체 화면' : 'Fullscreen'}</button
    >
  </div>
  <p class="shortcut-hint">
    {
      ko
        ? '단축키: 스페이스 시작/정지 · L 랩 · R 초기화'
        : 'Shortcuts: Space start/pause · L lap · R reset'
    }
  </p>
  <div class="lap-stats" data-lap-stats hidden></div>
  <ol class="lap-list" data-lap-list aria-label={ko ? '랩 기록' : 'Lap times'}></ol>
  <button class="text-button" type="button" data-action="export-laps" disabled
    >{ko ? '랩 CSV 다운로드' : 'Download laps CSV'}</button
  >
  <p class="tool-note">
    {
      ko
        ? '새로고침하면 기록이 지워집니다. 필요한 랩은 먼저 다운로드하세요. 기기 절전 중 측정은 브라우저에 따라 다를 수 있습니다.'
        : 'Refreshing clears this session. Download any laps you need first. Timing during device sleep can vary by browser.'
    }
  </p>
</section>
