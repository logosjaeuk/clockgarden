---
import type { Locale } from '../config';
const { locale } = Astro.props as { locale: Locale };
const ko = locale === 'ko';
---

<section class="instrument" data-tool="timer" data-locale={locale}>
  <form class="duration-form" data-duration-form>
    <label
      ><span>{ko ? '시간' : 'Hours'}</span><input
        name="hours"
        type="number"
        inputmode="numeric"
        min="0"
        max="999"
        value="0"
      /></label
    >
    <span class="duration-separator" aria-hidden="true">:</span>
    <label
      ><span>{ko ? '분' : 'Minutes'}</span><input
        name="minutes"
        type="number"
        inputmode="numeric"
        min="0"
        max="59"
        value="5"
      /></label
    >
    <span class="duration-separator" aria-hidden="true">:</span>
    <label
      ><span>{ko ? '초' : 'Seconds'}</span><input
        name="seconds"
        type="number"
        inputmode="numeric"
        min="0"
        max="59"
        value="0"
      /></label
    >
  </form>
  <div class="timer-visual" data-timer-visual>
    <div class="hero-time timer-time" data-timer-time role="timer">00:05:00</div>
  </div>
  <div class="preset-row" aria-label={ko ? '타이머 프리셋' : 'Timer presets'}>
    <button class="chip" type="button" data-preset="60">{ko ? '1분' : '1m'}</button><button
      class="chip"
      type="button"
      data-preset="300">{ko ? '5분' : '5m'}</button
    ><button class="chip" type="button" data-preset="600">{ko ? '10분' : '10m'}</button><button
      class="chip"
      type="button"
      data-preset="1500">{ko ? '25분' : '25m'}</button
    >
  </div>
  <div class="primary-controls">
    <button class="button primary" type="button" data-action="start">{ko ? '시작' : 'Start'}</button
    >
    <button class="button" type="button" data-action="add">{ko ? '+1분' : '+1 min'}</button>
    <button class="button" type="button" data-action="reset">{ko ? '초기화' : 'Reset'}</button>
    <button class="button quiet" type="button" data-action="fullscreen"
      >{ko ? '전체 화면' : 'Fullscreen'}</button
    >
  </div>
  <div class="option-row">
    <button class="text-button" type="button" data-action="test-sound"
      >{ko ? '소리 테스트' : 'Test sound'}</button
    >
    <label class="toggle-label"
      ><input type="checkbox" data-repeat /> {ko ? '반복 타이머' : 'Repeat timer'}</label
    >
    <button class="text-button" type="button" data-action="notifications"
      >{ko ? '완료 알림 사용' : 'Enable completion notifications'}</button
    >
  </div>
  <p class="status-line" data-status aria-live="polite"></p>
  <p class="tool-note">
    {
      ko
        ? '이 탭을 열어 두세요. 새로고침 후에도 남은 시간을 복원하지만, 잠금·절전 중 알림은 보장되지 않습니다.'
        : 'Keep this tab open. The countdown survives a refresh, but alerts are not guaranteed while your device is locked or asleep.'
    }
  </p>
  <details class="saved-settings">
    <summary>{ko ? '내 타이머 · 저장하고 다시 사용' : 'My timers · save and reuse'}</summary>
    <form data-save-timer class="save-timer-form">
      <label
        ><span>{ko ? '타이머 이름' : 'Timer name'}</span><input
          name="label"
          maxlength="40"
          required
          placeholder={ko ? '예: 차 우리기' : 'e.g. Tea break'}
        /></label
      >
      <button class="button" type="submit">{ko ? '현재 시간 저장' : 'Save duration'}</button>
      <button class="text-button" type="button" data-action="share-timer"
        >{ko ? '타이머 링크 복사' : 'Copy timer link'}</button
      >
    </form>
    <ul class="saved-timers" data-saved-timers></ul>
    <p class="tool-note">
      {
        ko
          ? '최대 8개. 이 브라우저에만 저장됩니다. 저장한 시간을 선택한 뒤 시작하세요.'
          : 'Up to 8, saved only in this browser. Choose a saved duration, then press Start.'
      }
    </p>
  </details>
</section>
