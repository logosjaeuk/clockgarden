---
import type { Locale } from '../config';
import { copy, pathFor } from '../i18n';
const { locale } = Astro.props as { locale: Locale };
const t = copy[locale].nav;
const items = [
  [
    '/stopwatch/',
    t.stopwatch,
    locale === 'ko' ? '랩과 통계가 있는 정밀 스톱워치' : 'Precise laps and split statistics',
  ],
  [
    '/timer/',
    t.timer,
    locale === 'ko'
      ? '반복과 알림을 지원하는 카운트다운'
      : 'Countdowns with repeat and notifications',
  ],
  [
    '/alarm/',
    t.alarm,
    locale === 'ko' ? '브라우저에 저장되는 여러 알람' : 'Multiple locally saved alarms',
  ],
  [
    '/world-clock/',
    t.world,
    locale === 'ko' ? '여러 도시의 현재 시간 비교' : 'Compare current times across cities',
  ],
  [
    '/time-zone-converter/',
    t.converter,
    locale === 'ko' ? 'DST를 반영한 시간 변환' : 'DST-aware time conversion',
  ],
] as const;
---

<nav class="tool-cards" aria-label={locale === 'ko' ? '시간 도구' : 'Time tools'}>
  {
    items.map(([href, title, description]) => (
      <a href={pathFor(locale, href)}>
        <>
          <span>{title}</span>
          <small>{description}</small>
          <b aria-hidden="true">→</b>
        </>
      </a>
    ))
  }
</nav>
