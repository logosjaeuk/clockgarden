---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const articles = await getCollection('articles');
  return articles.map((article) => ({
    params: { slug: article.id },
    props: { article },
  }));
}

const { article } = Astro.props;
const { Content, headings } = await render(article);

const allArticles = await getCollection('articles');
const relatedArticles = allArticles
  .filter(a => a.id !== article.id && a.data.categorySlug === article.data.categorySlug)
  .slice(0, 3);

// If not enough in same category, fill with others
if (relatedArticles.length < 3) {
  const others = allArticles.filter(a => a.id !== article.id && !relatedArticles.includes(a)).slice(0, 3 - relatedArticles.length);
  relatedArticles.push(...others);
}

const tocHeadings = headings.filter(h => h.depth === 2 || h.depth === 3);
---

<BaseLayout
  title={article.data.title}
  description={article.data.description}
  path={`/articles/${article.id}/`}
  locale="ko"
  article={{
    publishedTime: article.data.pubDate,
    modifiedTime: article.data.updatedDate,
    author: article.data.author,
    section: article.data.category,
    tags: article.data.tags,
  }}
>
  <article class="article-layout">
    <!-- Breadcrumbs -->
    <nav class="breadcrumb" aria-label="탐색 경로">
      <ol itemscope itemtype="https://schema.org/BreadcrumbList">
        <li itemprop="itemListElement" itemscope itemtype="https://schema.org/ListItem">
          <a itemprop="item" href="/"><span itemprop="name">홈</span></a>
          <meta itemprop="position" content="1" />
        </li>
        <li class="separator">/</li>
        <li itemprop="itemListElement" itemscope itemtype="https://schema.org/ListItem">
          <a itemprop="item" href="/articles/"><span itemprop="name">저널</span></a>
          <meta itemprop="position" content="2" />
        </li>
        <li class="separator">/</li>
        <li itemprop="itemListElement" itemscope itemtype="https://schema.org/ListItem">
          <a itemprop="item" href={`/category/${article.data.categorySlug}/`}>
            <span itemprop="name">{article.data.category}</span>
          </a>
          <meta itemprop="position" content="3" />
        </li>
      </ol>
    </nav>

    <!-- Header -->
    <header class="article-header">
      <div class="header-cat">
        <a href={`/category/${article.data.categorySlug}/`}>{article.data.category}</a>
      </div>
      <h1 class="article-title">{article.data.title}</h1>
      <p class="article-lead">{article.data.description}</p>

      <div class="byline">
        <div class="author-block">
          <div class="author-avatar" aria-hidden="true">CG</div>
          <div>
            <div class="author-name">{article.data.author}</div>
            <div class="author-role">{article.data.authorRole}</div>
          </div>
        </div>

        <div class="meta-block">
          <div class="date-row">
            <span>발행일:</span>
            <time datetime={article.data.pubDate}>{article.data.pubDate}</time>
          </div>
          {article.data.updatedDate && (
            <div class="date-row">
              <span>최종 검토:</span>
              <time datetime={article.data.updatedDate}>{article.data.updatedDate}</time>
            </div>
          )}
          <div class="read-row">
            <span>읽는 시간:</span>
            <span>약 {article.data.readTime}분</span>
          </div>
        </div>
      </div>
    </header>

    <!-- Main Content & Sidebar -->
    <div class="content-wrapper">
      <div class="prose">
        <!-- Key Takeaways Box -->
        <aside class="key-takeaways" aria-label="핵심 요약">
          <div class="takeaways-title">
            <span class="icon">✦</span> 핵심 요약 & 엔지니어링 관점
          </div>
          <ul>
            <li><strong>주제:</strong> {article.data.title}</li>
            <li><strong>분야:</strong> {article.data.category} ({article.data.tags.join(', ')})</li>
            <li><strong>검증:</strong> 클락가든 시계공학 연구팀의 팩트체크 및 학술/특허 자료 기반 분석</li>
          </ul>
        </aside>

        <!-- Markdown Rendered Body -->
        <Content />

        <!-- Tag List -->
        <div class="article-tags">
          <span class="tag-label">태그:</span>
          {article.data.tags.map((tag) => (
            <span class="tag-pill">#{tag}</span>
          ))}
        </div>

        <!-- Editorial Fact-Check Box -->
        <section class="editorial-guarantee">
          <h3>클락가든 에디토리얼 투명성 원칙</h3>
          <p>
            본 저널의 모든 아티클은 시계학(Horology) 문헌, 스위스 공식 크로노미터(COSC/METAS) 규격, 국제도량형총회(CGPM) 기술 문서 및 물리학적 원리를 바탕으로 집필·검증됩니다. 내용상 수정이 필요하거나 학술적 제언이 있으실 경우 <a href="/contact/">편집팀 문의</a>를 통해 의견을 남겨주시면 정정 정책에 따라 성실히 반영합니다.
          </p>
        </section>
      </div>

      <!-- Sticky Sidebar (TOC) -->
      <aside class="sidebar" aria-label="목차">
        <div class="sticky-box">
          <div class="toc-card">
            <h2 class="toc-title">목차</h2>
            <nav class="toc-nav">
              <ul>
                {tocHeadings.map((h) => (
                  <li class={`toc-item depth-${h.depth}`}>
                    <a href={`#${h.slug}`}>{h.text}</a>
                  </li>
                ))}
              </ul>
            </nav>
          </div>

          <div class="tool-banner">
            <p class="tool-banner-title">정밀 시간 계측 도구</p>
            <p class="tool-banner-desc">웹 브라우저에서 실행되는 클락가든의 정밀 시계 및 세계 시각 변환기를 사용해 보세요.</p>
            <a href="/clock/" class="tool-btn">시계 도구 열기 &rarr;</a>
          </div>
        </div>
      </aside>
    </div>

    <!-- Related Articles -->
    <section class="related-section">
      <h2 class="related-title">함께 읽으면 좋은 전문 칼럼</h2>
      <div class="related-grid">
        {relatedArticles.map((rel) => (
          <div class="related-card">
            <span class="rel-cat">{rel.data.category}</span>
            <h3 class="rel-title">
              <a href={`/articles/${rel.id}/`}>{rel.data.title}</a>
            </h3>
            <p class="rel-desc">{rel.data.description}</p>
            <span class="rel-meta">{rel.data.pubDate} · {rel.data.readTime}분 읽기</span>
          </div>
        ))}
      </div>
    </section>
  </article>
</BaseLayout>

<style>
  .article-layout {
    max-width: 1200px;
    margin: 0 auto;
    padding: 2.5rem 1.5rem 6rem;
  }
  .breadcrumb {
    margin-bottom: 2rem;
    font-size: 0.88rem;
  }
  .breadcrumb ol {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem;
    color: var(--muted);
  }
  .breadcrumb a {
    color: var(--muted);
    text-decoration: none;
    transition: color 0.15s;
  }
  .breadcrumb a:hover {
    color: var(--accent);
  }
  .breadcrumb .separator {
    color: var(--line);
  }
  .article-header {
    max-width: 860px;
    margin-bottom: 3.5rem;
  }
  .header-cat {
    margin-bottom: 0.85rem;
  }
  .header-cat a {
    display: inline-block;
    padding: 0.3rem 0.8rem;
    font-size: 0.82rem;
    font-weight: 600;
    color: var(--accent);
    background: var(--accent-soft);
    border-radius: 999px;
    text-decoration: none;
  }
  .article-title {
    font-size: clamp(2rem, 4.2vw, 3rem);
    font-weight: 800;
    line-height: 1.25;
    letter-spacing: -0.035em;
    color: var(--text);
    margin: 0 0 1.25rem;
  }
  .article-lead {
    font-size: 1.22rem;
    line-height: 1.65;
    color: var(--muted);
    margin: 0 0 2rem;
  }
  .byline {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: center;
    padding: 1.25rem 0;
    border-top: 1px solid var(--line);
    border-bottom: 1px solid var(--line);
    gap: 1.25rem;
  }
  .author-block {
    display: flex;
    align-items: center;
    gap: 0.85rem;
  }
  .author-avatar {
    width: 44px;
    height: 44px;
    border-radius: 50%;
    background: var(--accent);
    color: #fff;
    display: flex;
    align-items: center;
    justify-content: center;
    font-weight: 700;
    font-size: 0.95rem;
    letter-spacing: -0.05em;
  }
  .author-name {
    font-weight: 700;
    color: var(--text);
    font-size: 0.98rem;
  }
  .author-role {
    font-size: 0.82rem;
    color: var(--muted);
  }
  .meta-block {
    display: flex;
    flex-wrap: wrap;
    gap: 1.5rem;
    font-size: 0.86rem;
    color: var(--muted);
  }
  .date-row, .read-row {
    display: flex;
    gap: 0.35rem;
  }
  .content-wrapper {
    display: grid;
    grid-template-columns: 1fr 310px;
    gap: 3.5rem;
    align-items: start;
  }
  @media (max-width: 960px) {
    .content-wrapper {
      grid-template-columns: 1fr;
    }
    .sidebar {
      display: none;
    }
  }
  .prose {
    font-size: 1.1rem;
    line-height: 1.85;
    color: var(--text);
    max-width: 100%;
    overflow-wrap: break-word;
  }
  .prose :global(h2) {
    font-size: 1.75rem;
    font-weight: 800;
    letter-spacing: -0.025em;
    line-height: 1.35;
    margin: 3rem 0 1.25rem;
    padding-bottom: 0.65rem;
    border-bottom: 1px solid var(--line);
    color: var(--text);
    scroll-margin-top: 5rem;
  }
  .prose :global(h3) {
    font-size: 1.35rem;
    font-weight: 700;
    letter-spacing: -0.015em;
    line-height: 1.4;
    margin: 2.25rem 0 1rem;
    color: var(--text);
    scroll-margin-top: 5rem;
  }
  .prose :global(p) {
    margin: 0 0 1.5rem;
  }
  .prose :global(ul), .prose :global(ol) {
    margin: 0 0 1.75rem;
    padding-left: 1.6rem;
  }
  .prose :global(li) {
    margin-bottom: 0.5rem;
  }
  .prose :global(blockquote) {
    margin: 2rem 0;
    padding: 1.25rem 1.75rem;
    border-left: 4px solid var(--accent);
    background: var(--surface);
    border-radius: 0 var(--radius) var(--radius) 0;
    font-style: italic;
    color: var(--text);
  }
  .prose :global(blockquote p:last-child) {
    margin-bottom: 0;
  }
  .prose :global(pre) {
    margin: 2rem 0;
    padding: 1.5rem;
    background: var(--surface-solid);
    border: 1px solid var(--line);
    border-radius: var(--radius);
    overflow-x: auto;
    font-size: 0.92rem;
    line-height: 1.6;
  }
  .prose :global(table) {
    width: 100%;
    margin: 2.5rem 0;
    border-collapse: collapse;
    font-size: 0.95rem;
    overflow-x: auto;
    display: block;
  }
  .prose :global(th), .prose :global(td) {
    padding: 0.85rem 1rem;
    border: 1px solid var(--line);
    text-align: left;
  }
  .prose :global(th) {
    background: var(--surface-solid);
    font-weight: 700;
  }
  .key-takeaways {
    background: var(--accent-soft);
    border: 1px solid var(--accent);
    border-radius: var(--radius);
    padding: 1.75rem;
    margin-bottom: 2.5rem;
  }
  .takeaways-title {
    font-weight: 700;
    font-size: 1.05rem;
    color: var(--accent-strong);
    margin-bottom: 0.85rem;
  }
  .key-takeaways ul {
    margin: 0;
    padding-left: 1.3rem;
  }
  .key-takeaways li {
    font-size: 0.98rem;
    line-height: 1.6;
    margin-bottom: 0.4rem;
  }
  .article-tags {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem;
    margin: 3rem 0;
    padding-top: 1.5rem;
    border-top: 1px solid var(--line);
  }
  .tag-label {
    font-weight: 600;
    font-size: 0.9rem;
    color: var(--muted);
  }
  .tag-pill {
    padding: 0.25rem 0.75rem;
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: 999px;
    font-size: 0.82rem;
    color: var(--muted);
  }
  .editorial-guarantee {
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: var(--radius);
    padding: 2rem;
    margin-top: 3.5rem;
  }
  .editorial-guarantee h3 {
    margin: 0 0 0.75rem;
    font-size: 1.15rem;
    color: var(--text);
  }
  .editorial-guarantee p {
    font-size: 0.92rem;
    line-height: 1.65;
    color: var(--muted);
    margin: 0;
  }
  .editorial-guarantee a {
    color: var(--accent);
    font-weight: 600;
  }
  .sidebar .sticky-box {
    position: sticky;
    top: 5.5rem;
    display: flex;
    flex-direction: column;
    gap: 1.75rem;
  }
  .toc-card {
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: var(--radius);
    padding: 1.5rem;
    box-shadow: var(--shadow);
  }
  .toc-title {
    font-size: 1rem;
    font-weight: 700;
    margin: 0 0 1rem;
    color: var(--text);
  }
  .toc-nav ul {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 0.55rem;
  }
  .toc-item a {
    color: var(--muted);
    text-decoration: none;
    font-size: 0.86rem;
    line-height: 1.45;
    display: block;
    transition: color 0.15s;
  }
  .toc-item a:hover {
    color: var(--accent);
  }
  .toc-item.depth-3 {
    padding-left: 0.85rem;
    font-size: 0.82rem;
  }
  .tool-banner {
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: var(--radius);
    padding: 1.5rem;
    text-align: center;
  }
  .tool-banner-title {
    font-weight: 700;
    font-size: 0.95rem;
    margin: 0 0 0.5rem;
    color: var(--text);
  }
  .tool-banner-desc {
    font-size: 0.82rem;
    line-height: 1.5;
    color: var(--muted);
    margin: 0 0 1rem;
  }
  .tool-btn {
    display: inline-block;
    padding: 0.55rem 1.15rem;
    font-size: 0.86rem;
    font-weight: 600;
    color: #fff;
    background: var(--accent);
    border-radius: 999px;
    text-decoration: none;
    transition: background 0.15s;
  }
  .tool-btn:hover {
    background: var(--accent-strong);
  }
  .related-section {
    margin-top: 5rem;
    padding-top: 3.5rem;
    border-top: 1px solid var(--line);
  }
  .related-title {
    font-size: 1.6rem;
    font-weight: 800;
    margin: 0 0 2rem;
    color: var(--text);
  }
  .related-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(320px, 1fr));
    gap: 1.75rem;
  }
  .related-card {
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: var(--radius);
    padding: 1.75rem;
    display: flex;
    flex-direction: column;
  }
  .rel-cat {
    font-size: 0.8rem;
    font-weight: 600;
    color: var(--accent);
    margin-bottom: 0.65rem;
  }
  .rel-title {
    font-size: 1.15rem;
    font-weight: 700;
    line-height: 1.4;
    margin: 0 0 0.75rem;
  }
  .rel-title a {
    color: var(--text);
    text-decoration: none;
  }
  .rel-title a:hover {
    color: var(--accent);
  }
  .rel-desc {
    font-size: 0.9rem;
    line-height: 1.55;
    color: var(--muted);
    margin: 0 0 1.25rem;
    flex-grow: 1;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  .rel-meta {
    font-size: 0.8rem;
    color: var(--muted);
  }
</style>
