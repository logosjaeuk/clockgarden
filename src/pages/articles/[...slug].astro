---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const articles = await getCollection('articles');
  return articles.map((article) => ({
    params: { slug: article.id },
    props: { article },
  }));
}

const { article } = Astro.props;
const { Content, headings } = await render(article);

const allArticles = await getCollection('articles');
const relatedArticles = allArticles
  .filter(a => a.id !== article.id && a.data.categorySlug === article.data.categorySlug)
  .slice(0, 3);

if (relatedArticles.length < 3) {
  const others = allArticles.filter(a => a.id !== article.id && !relatedArticles.includes(a)).slice(0, 3 - relatedArticles.length);
  relatedArticles.push(...others);
}

const tocHeadings = headings.filter(h => h.depth === 2 || h.depth === 3);
---

<BaseLayout
  title={article.data.title}
  description={article.data.description}
  path={`/articles/${article.id}/`}
  locale="ko"
  article={{
    publishedTime: article.data.pubDate,
    modifiedTime: article.data.updatedDate,
    author: article.data.author,
    section: article.data.category,
    tags: article.data.tags,
  }}
>
  <article class="article-layout">
    <!-- Breadcrumbs -->
    <nav class="breadcrumb" aria-label="탐색 경로">
      <ol itemscope itemtype="https://schema.org/BreadcrumbList">
        <li itemprop="itemListElement" itemscope itemtype="https://schema.org/ListItem">
          <a itemprop="item" href="/"><span itemprop="name">홈</span></a>
          <meta itemprop="position" content="1" />
        </li>
        <li class="separator">/</li>
        <li itemprop="itemListElement" itemscope itemtype="https://schema.org/ListItem">
          <a itemprop="item" href="/articles/"><span itemprop="name">전체 가이드</span></a>
          <meta itemprop="position" content="2" />
        </li>
        <li class="separator">/</li>
        <li itemprop="itemListElement" itemscope itemtype="https://schema.org/ListItem">
          <a itemprop="item" href={`/category/${article.data.categorySlug}/`}>
            <span itemprop="name">{article.data.category}</span>
          </a>
          <meta itemprop="position" content="3" />
        </li>
      </ol>
    </nav>

    <!-- Header -->
    <header class="article-header">
      <div class="header-cat">
        <a href={`/category/${article.data.categorySlug}/`}>{article.data.category}</a>
      </div>
      <h1 class="article-title">{article.data.title}</h1>
      <p class="article-lead">{article.data.description}</p>

      <div class="byline">
        <div class="author-block">
          <div class="author-avatar" aria-hidden="true">CG</div>
          <div>
            <div class="author-name">{article.data.author}</div>
            <div class="author-role">{article.data.authorRole}</div>
          </div>
        </div>

        <div class="meta-block">
          <div class="date-row">
            <span>발행일:</span>
            <time datetime={article.data.pubDate}>{article.data.pubDate}</time>
          </div>
          {article.data.updatedDate && (
            <div class="date-row">
              <span>최종 검토:</span>
              <time datetime={article.data.updatedDate}>{article.data.updatedDate}</time>
            </div>
          )}
          <div class="read-row">
            <span>읽는 시간:</span>
            <span>약 {article.data.readTime}분</span>
          </div>
        </div>
      </div>
    </header>

    <!-- Main Content & Sidebar -->
    <div class="content-wrapper">
      <div class="prose">
        <!-- Key Takeaways Box -->
        <aside class="key-takeaways" aria-label="핵심 요약">
          <div class="takeaways-title">
            <span class="icon">✦</span> 핵심 요약 & 실무 적용 포인트
          </div>
          <ul>
            <li><strong>주제:</strong> {article.data.title}</li>
            <li><strong>분야:</strong> {article.data.category} ({article.data.tags.join(', ')})</li>
            <li><strong>검증:</strong> 클락가든 스마트 워크 연구팀의 최신 소프트웨어 실무 테스트 및 검증 완료</li>
          </ul>
        </aside>

        <!-- Markdown Rendered Body -->
        <Content />

        <!-- Tag List -->
        <div class="article-tags">
          <span class="tag-label">태그:</span>
          {article.data.tags.map((tag) => (
            <span class="tag-pill">#{tag}</span>
          ))}
        </div>

        <!-- Editorial Quality Box -->
        <section class="editorial-guarantee">
          <h3>클락가든 실무 가이드 품질 원칙</h3>
          <p>
            본 저널의 모든 가이드는 Microsoft 365, Google Workspace, Notion 최신 빌드에서 직접 테스트를 거쳐 집필됩니다. 수식 오류나 버전 호환성 제보가 있으실 경우 <a href="/contact/">연구팀 문의</a>를 통해 의견을 남겨주시면 정정 정책에 따라 24시간 이내에 반영합니다.
          </p>
        </section>
      </div>

      <!-- Sticky Sidebar (TOC) -->
      <aside class="sidebar" aria-label="목차">
        <div class="sticky-box">
          <div class="toc-card">
            <h2 class="toc-title">목차</h2>
            <nav class="toc-nav">
              <ul>
                {tocHeadings.map((h) => (
                  <li class={`toc-item depth-${h.depth}`}>
                    <a href={`#${h.slug}`}>{h.text}</a>
                  </li>
                ))}
              </ul>
            </nav>
          </div>

          <div class="tool-banner">
            <p class="tool-banner-title">스마트 워크 지식 아카이브</p>
            <p class="tool-banner-desc">엑셀 고급 수식, 노션 템플릿, 업무 서식으로 소중한 시간을 아끼세요.</p>
            <a href="/articles/" class="tool-btn">전체 실무 가이드 보기 &rarr;</a>
          </div>
        </div>
      </aside>
    </div>

    <!-- Related Articles -->
    <section class="related-section">
      <h2 class="related-title">함께 읽으면 좋은 실무 가이드</h2>
      <div class="related-grid">
        {relatedArticles.map((rel) => (
          <div class="related-card">
            <span class="rel-cat">{rel.data.category}</span>
            <h3 class="rel-title">
              <a href={`/articles/${rel.id}/`}>{rel.data.title}</a>
            </h3>
            <p class="rel-desc">{rel.data.description}</p>
            <span class="rel-meta">{rel.data.pubDate} · {rel.data.readTime}분 읽기</span>
          </div>
        ))}
      </div>
    </section>
  </article>
</BaseLayout>

<style>
  .article-layout {
    max-width: 1140px;
    margin: 0 auto;
    padding: 2.5rem 1.5rem 6rem;
  }
  .breadcrumb {
    margin-bottom: 2rem;
    font-size: 0.88rem;
  }
  .breadcrumb ol {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem;
    color: var(--muted);
  }
  .breadcrumb a {
    color: var(--muted);
    text-decoration: none;
  }
  .breadcrumb a:hover {
    color: var(--accent);
  }
  .separator {
    color: var(--line);
  }

  .article-header {
    margin-bottom: 3rem;
    padding-bottom: 2.5rem;
    border-bottom: 1px solid var(--line);
  }
  .header-cat {
    margin-bottom: 0.75rem;
  }
  .header-cat a {
    display: inline-block;
    font-size: 0.8125rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--accent);
  }
  .article-title {
    font-size: 2.5rem;
    font-weight: 800;
    line-height: 1.25;
    letter-spacing: -0.02em;
    margin: 0 0 1.25rem;
    color: var(--text);
  }
  .article-lead {
    font-size: 1.1875rem;
    line-height: 1.7;
    color: var(--muted);
    margin: 0 0 2rem;
    max-width: 820px;
  }

  .byline {
    display: flex;
    justify-content: space-between;
    align-items: center;
    flex-wrap: wrap;
    gap: 1.5rem;
    padding-top: 1.5rem;
    border-top: 1px solid var(--line);
  }
  .author-block {
    display: flex;
    align-items: center;
    gap: 0.85rem;
  }
  .author-avatar {
    width: 44px;
    height: 44px;
    border-radius: 50%;
    background: var(--accent-soft);
    color: var(--accent);
    font-weight: 800;
    font-size: 0.95rem;
    display: flex;
    align-items: center;
    justify-content: center;
    border: 1px solid var(--line);
  }
  .author-name {
    font-weight: 700;
    color: var(--text);
    font-size: 0.95rem;
  }
  .author-role {
    font-size: 0.8125rem;
    color: var(--muted);
  }

  .meta-block {
    display: flex;
    align-items: center;
    gap: 1.25rem;
    font-size: 0.8125rem;
    color: var(--muted);
    flex-wrap: wrap;
  }
  .date-row, .read-row {
    display: flex;
    gap: 0.35rem;
  }

  .content-wrapper {
    display: grid;
    grid-template-columns: 1fr;
    gap: 3.5rem;
  }

  @media (min-width: 960px) {
    .content-wrapper {
      grid-template-columns: minmax(0, 1fr) 280px;
    }
  }

  .key-takeaways {
    background: var(--bg-alt);
    border: 1px solid var(--line);
    border-left: 4px solid var(--accent);
    border-radius: var(--radius);
    padding: 1.5rem;
    margin-bottom: 2.5rem;
  }
  .takeaways-title {
    font-weight: 700;
    color: var(--text);
    margin-bottom: 0.75rem;
    font-size: 0.95rem;
    display: flex;
    align-items: center;
    gap: 0.4rem;
  }
  .takeaways-title .icon {
    color: var(--accent);
  }
  .key-takeaways ul {
    margin: 0;
    padding-left: 1.25rem;
    font-size: 0.9375rem;
    line-height: 1.7;
    color: var(--muted);
  }
  .key-takeaways strong {
    color: var(--text);
  }

  .article-tags {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem;
    margin: 3.5rem 0 2rem;
    padding-top: 2rem;
    border-top: 1px solid var(--line);
  }
  .tag-label {
    font-size: 0.875rem;
    font-weight: 600;
    color: var(--muted);
  }
  .tag-pill {
    background: var(--bg-alt);
    color: var(--text);
    border: 1px solid var(--line);
    padding: 0.35rem 0.75rem;
    border-radius: 9999px;
    font-size: 0.8125rem;
    font-weight: 500;
  }

  .editorial-guarantee {
    background: var(--bg-alt);
    border: 1px solid var(--line);
    border-radius: var(--radius);
    padding: 1.5rem;
    margin-top: 2rem;
  }
  .editorial-guarantee h3 {
    margin: 0 0 0.5rem;
    font-size: 1rem;
    font-weight: 700;
    color: var(--text);
  }
  .editorial-guarantee p {
    margin: 0;
    font-size: 0.875rem;
    line-height: 1.6;
    color: var(--muted);
  }
  .editorial-guarantee a {
    color: var(--accent);
    text-decoration: underline;
  }

  /* Sidebar */
  .sidebar {
    display: none;
  }
  @media (min-width: 960px) {
    .sidebar {
      display: block;
    }
  }
  .sticky-box {
    position: sticky;
    top: 5.5rem;
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }
  .toc-card {
    background: var(--bg-alt);
    border: 1px solid var(--line);
    border-radius: var(--radius);
    padding: 1.25rem;
    max-height: calc(100vh - 180px);
    overflow-y: auto;
  }
  .toc-title {
    font-size: 0.8125rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--text);
    margin: 0 0 1rem;
    padding-bottom: 0.5rem;
    border-bottom: 1px solid var(--line);
  }
  .toc-nav ul {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
  }
  .toc-item a {
    color: var(--muted);
    font-size: 0.8125rem;
    line-height: 1.4;
    display: block;
    padding: 0.2rem 0;
    transition: color 0.15s;
  }
  .toc-item a:hover {
    color: var(--accent);
  }
  .toc-item.depth-3 {
    padding-left: 0.75rem;
    font-size: 0.75rem;
  }

  .tool-banner {
    background: linear-gradient(135deg, rgba(37, 99, 235, 0.08) 0%, rgba(59, 130, 246, 0.04) 100%);
    border: 1px solid rgba(37, 99, 235, 0.2);
    border-radius: var(--radius);
    padding: 1.25rem;
  }
  .tool-banner-title {
    font-weight: 700;
    color: var(--text);
    font-size: 0.9375rem;
    margin: 0 0 0.35rem;
  }
  .tool-banner-desc {
    font-size: 0.8125rem;
    line-height: 1.5;
    color: var(--muted);
    margin: 0 0 1rem;
  }
  .tool-btn {
    display: block;
    text-align: center;
    background: var(--accent);
    color: #fff;
    padding: 0.55rem 1rem;
    border-radius: var(--radius-sm);
    font-size: 0.8125rem;
    font-weight: 600;
    transition: opacity 0.15s;
  }
  .tool-btn:hover {
    opacity: 0.9;
  }

  /* Related Section */
  .related-section {
    margin-top: 5rem;
    padding-top: 3rem;
    border-top: 1px solid var(--line);
  }
  .related-title {
    font-size: 1.5rem;
    font-weight: 700;
    margin: 0 0 2rem;
    color: var(--text);
  }
  .related-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: 1.5rem;
  }
  .related-card {
    background: var(--bg-alt);
    border: 1px solid var(--line);
    border-radius: var(--radius);
    padding: 1.5rem;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    transition: transform 0.15s, border-color 0.15s;
  }
  .related-card:hover {
    transform: translateY(-2px);
    border-color: var(--accent);
  }
  .rel-cat {
    font-size: 0.75rem;
    font-weight: 700;
    color: var(--accent);
    text-transform: uppercase;
    margin-bottom: 0.5rem;
  }
  .rel-title {
    font-size: 1.125rem;
    font-weight: 700;
    line-height: 1.4;
    margin: 0 0 0.5rem;
  }
  .rel-title a {
    color: var(--text);
  }
  .rel-title a:hover {
    color: var(--accent);
  }
  .rel-desc {
    font-size: 0.875rem;
    color: var(--muted);
    line-height: 1.6;
    margin: 0 0 1rem;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  .rel-meta {
    font-size: 0.75rem;
    color: var(--muted);
  }
</style>
