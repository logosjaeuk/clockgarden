---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

const articles = await getCollection('articles');
const sortedArticles = articles.sort(
  (a, b) => new Date(b.data.pubDate).getTime() - new Date(a.data.pubDate).getTime()
);

const categories = [
  { slug: 'all', name: '전체 가이드', count: sortedArticles.length },
  { slug: 'spreadsheet', name: '엑셀 & 스프레드시트', count: sortedArticles.filter(a => a.data.categorySlug === 'spreadsheet').length },
  { slug: 'notion', name: '노션 & 생산성 앱', count: sortedArticles.filter(a => a.data.categorySlug === 'notion').length },
  { slug: 'templates', name: '실무 서식 & 템플릿', count: sortedArticles.filter(a => a.data.categorySlug === 'templates').length },
  { slug: 'workflow', name: '워크플로우 & 단축키', count: sortedArticles.filter(a => a.data.categorySlug === 'workflow').length },
];
---

<BaseLayout
  title="스마트 워크 & 실무 도구 가이드 전체보기"
  description="엑셀, 구글 스프레드시트, 노션, 실무 템플릿 서식, 업무 자동화 워크플로우 등 직장인과 프리랜서의 시간을 절약해주는 클락가든의 실무 가이드 아카이브입니다."
  path="/articles/"
  locale="ko"
>
  <div class="content-container">
    <header class="page-header">
      <div class="category-badge">Smart Work Field Guide</div>
      <h1 class="page-title">스마트 워크 & 실무 도구 가이드</h1>
      <p class="page-subtitle">
        반복적인 수작업을 없애고 업무 효율을 극대화하는 실무 테크닉을 정리합니다. 엑셀 고급 수식부터 노션 데이터베이스, 실무 서식과 단축키 꿀팁까지 바로 적용해 보세요.
      </p>
    </header>

    <nav class="category-nav" aria-label="카테고리 필터">
      {categories.map((cat) => (
        <a
          href={cat.slug === 'all' ? '/articles/' : `/category/${cat.slug}/`}
          class={`cat-chip ${cat.slug === 'all' ? 'active' : ''}`}
        >
          {cat.name} <span class="count">({cat.count})</span>
        </a>
      ))}
    </nav>

    <div class="articles-grid">
      {sortedArticles.map((article) => (
        <article class="article-card">
          <div class="card-meta">
            <a href={`/category/${article.data.categorySlug}/`} class="card-cat">
              {article.data.category}
            </a>
            <span class="read-time">{article.data.readTime}분 분량</span>
          </div>

          <h2 class="card-title">
            <a href={`/articles/${article.id}/`}>
              {article.data.title}
            </a>
          </h2>

          <p class="card-desc">
            {article.data.description}
          </p>

          <div class="card-footer">
            <div class="author-info">
              <span class="author-name">{article.data.author}</span>
              <time datetime={article.data.pubDate} class="pub-date">{article.data.pubDate}</time>
            </div>
            <a href={`/articles/${article.id}/`} class="read-more-link" aria-label={`${article.data.title} 전문 읽기`}>
              가이드 보기 &rarr;
            </a>
          </div>
        </article>
      ))}
    </div>
  </div>
</BaseLayout>

<style>
  .content-container {
    max-width: 1120px;
    margin: 0 auto;
    padding: 2.5rem 1.5rem 5rem;
  }

  .page-header {
    margin-bottom: 2.5rem;
    padding-bottom: 2rem;
    border-bottom: 1px solid var(--color-border);
  }

  .category-badge {
    display: inline-block;
    font-size: 0.8125rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--color-accent);
    margin-bottom: 0.75rem;
  }

  .page-title {
    font-size: 2.5rem;
    font-weight: 700;
    line-height: 1.2;
    margin: 0 0 1rem;
    color: var(--color-text);
  }

  .page-subtitle {
    font-size: 1.125rem;
    line-height: 1.6;
    color: var(--color-text-muted);
    max-width: 760px;
    margin: 0;
  }

  .category-nav {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-bottom: 3rem;
  }

  .cat-chip {
    padding: 0.5rem 1rem;
    border-radius: 9999px;
    font-size: 0.875rem;
    font-weight: 500;
    text-decoration: none;
    color: var(--color-text);
    background: var(--color-bg-card, var(--color-bg-alt));
    border: 1px solid var(--color-border);
    transition: all 0.15s ease;
  }

  .cat-chip:hover {
    border-color: var(--color-accent);
    color: var(--color-accent);
  }

  .cat-chip.active {
    background: var(--color-accent);
    color: #fff;
    border-color: var(--color-accent);
  }

  .cat-chip .count {
    opacity: 0.75;
    font-size: 0.8125rem;
  }

  .articles-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(320px, 1fr));
    gap: 2rem;
  }

  .article-card {
    background: var(--color-bg-card, var(--color-bg-alt));
    border: 1px solid var(--color-border);
    border-radius: 8px;
    padding: 1.75rem;
    display: flex;
    flex-direction: column;
    transition: transform 0.2s ease, box-shadow 0.2s ease, border-color 0.2s ease;
  }

  .article-card:hover {
    transform: translateY(-2px);
    box-shadow: 0 8px 24px rgba(0, 0, 0, 0.06);
    border-color: var(--color-accent);
  }

  .card-meta {
    display: flex;
    justify-content: space-between;
    align-items: center;
    font-size: 0.8125rem;
    color: var(--color-text-muted);
    margin-bottom: 0.75rem;
  }

  .card-cat {
    font-weight: 600;
    color: var(--color-accent);
    text-decoration: none;
  }

  .card-cat:hover {
    text-decoration: underline;
  }

  .card-title {
    font-size: 1.25rem;
    font-weight: 600;
    line-height: 1.4;
    margin: 0 0 0.875rem;
  }

  .card-title a {
    color: var(--color-text);
    text-decoration: none;
    transition: color 0.15s ease;
  }

  .card-title a:hover {
    color: var(--color-accent);
  }

  .card-desc {
    font-size: 0.9375rem;
    line-height: 1.6;
    color: var(--color-text-muted);
    margin: 0 0 1.5rem;
    flex-grow: 1;
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .card-footer {
    display: flex;
    justify-content: space-between;
    align-items: center;
    font-size: 0.8125rem;
    padding-top: 1rem;
    border-top: 1px solid var(--color-border);
  }

  .author-info {
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
  }

  .author-name {
    font-weight: 500;
    color: var(--color-text);
  }

  .pub-date {
    color: var(--color-text-muted);
  }

  .read-more-link {
    font-weight: 600;
    color: var(--color-accent);
    text-decoration: none;
    display: inline-flex;
    align-items: center;
    gap: 0.25rem;
    transition: gap 0.15s ease;
  }

  .read-more-link:hover {
    gap: 0.5rem;
  }
</style>
