---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

const articles = await getCollection('articles');
const sortedArticles = articles.sort(
  (a, b) => new Date(b.data.pubDate).getTime() - new Date(a.data.pubDate).getTime()
);

const categories = [
  { slug: 'all', name: '전체 보기', count: sortedArticles.length },
  { slug: 'mechanics', name: '무브먼트 & 메커니즘', count: sortedArticles.filter(a => a.data.categorySlug === 'mechanics').length },
  { slug: 'history', name: '시간의 과학과 역사', count: sortedArticles.filter(a => a.data.categorySlug === 'history').length },
  { slug: 'astronomy', name: '천문시계 & 컴플리케이션', count: sortedArticles.filter(a => a.data.categorySlug === 'astronomy').length },
  { slug: 'horology-care', name: '시계 보존 및 관리 과학', count: sortedArticles.filter(a => a.data.categorySlug === 'horology-care').length },
];
---

<BaseLayout
  title="시계학 저널 & 전문 아티클"
  description="탈진기, 뚜르비옹, 쿼츠 진동자, 해상 크로노미터, 원자시계, 천문시계 등 시계공학과 시간 계측 과학의 모든 주제를 다루는 클락가든의 심층 저널입니다."
  path="/articles/"
  locale="ko"
>
  <div class="content-container">
    <header class="page-header">
      <div class="category-badge">Horology Journal</div>
      <h1 class="page-title">시계학 저널 & 전문 칼럼</h1>
      <p class="page-subtitle">
        시간을 물리적으로 쪼개고 제어하는 마이크로 기구학부터, 지구 자전과 원자 전이에 이르는 시간 측정의 대서사시를 공학적 시각으로 깊이 있게 조명합니다.
      </p>
    </header>

    <nav class="category-nav" aria-label="카테고리 필터">
      {categories.map((cat) => (
        <a
          href={cat.slug === 'all' ? '/articles/' : `/category/${cat.slug}/`}
          class={`cat-chip ${cat.slug === 'all' ? 'active' : ''}`}
        >
          {cat.name} <span class="count">({cat.count})</span>
        </a>
      ))}
    </nav>

    <div class="articles-grid">
      {sortedArticles.map((article) => (
        <article class="article-card">
          <div class="card-meta">
            <a href={`/category/${article.data.categorySlug}/`} class="card-cat">
              {article.data.category}
            </a>
            <span class="read-time">{article.data.readTime}분 분량</span>
          </div>

          <h2 class="card-title">
            <a href={`/articles/${article.id}/`}>
              {article.data.title}
            </a>
          </h2>

          <p class="card-desc">
            {article.data.description}
          </p>

          <div class="card-footer">
            <div class="author-info">
              <span class="author-name">{article.data.author}</span>
              <time datetime={article.data.pubDate} class="pub-date">{article.data.pubDate}</time>
            </div>
            <a href={`/articles/${article.id}/`} class="read-more-link" aria-label={`${article.data.title} 전문 읽기`}>
              읽기 &rarr;
            </a>
          </div>
        </article>
      ))}
    </div>
  </div>
</BaseLayout>

<style>
  .content-container {
    max-width: 1180px;
    margin: 0 auto;
    padding: 3.5rem 1.5rem 5rem;
  }
  .page-header {
    text-align: center;
    max-width: 820px;
    margin: 0 auto 3rem;
  }
  .category-badge {
    display: inline-block;
    padding: 0.35rem 0.85rem;
    font-size: 0.8rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--accent);
    background: var(--accent-soft);
    border-radius: 999px;
    margin-bottom: 1rem;
  }
  .page-title {
    font-size: clamp(2rem, 4vw, 2.85rem);
    font-weight: 800;
    letter-spacing: -0.03em;
    line-height: 1.25;
    margin: 0 0 1rem;
    color: var(--text);
  }
  .page-subtitle {
    font-size: 1.15rem;
    line-height: 1.65;
    color: var(--muted);
    margin: 0;
  }
  .category-nav {
    display: flex;
    flex-wrap: wrap;
    gap: 0.65rem;
    justify-content: center;
    margin-bottom: 3.5rem;
  }
  .cat-chip {
    padding: 0.55rem 1.1rem;
    border-radius: 999px;
    font-size: 0.92rem;
    font-weight: 500;
    color: var(--muted);
    background: var(--surface);
    border: 1px solid var(--line);
    text-decoration: none;
    transition: all 0.2s ease;
  }
  .cat-chip:hover {
    color: var(--text);
    border-color: var(--accent);
  }
  .cat-chip.active {
    color: var(--accent-strong);
    background: var(--accent-soft);
    border-color: var(--accent);
    font-weight: 600;
  }
  .cat-chip .count {
    opacity: 0.75;
    font-size: 0.82rem;
  }
  .articles-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(340px, 1fr));
    gap: 2rem;
  }
  .article-card {
    display: flex;
    flex-direction: column;
    padding: 2rem;
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: var(--radius);
    box-shadow: var(--shadow);
    transition: transform 0.25s ease, border-color 0.25s ease;
  }
  .article-card:hover {
    transform: translateY(-4px);
    border-color: var(--accent);
  }
  .card-meta {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 1rem;
    font-size: 0.82rem;
  }
  .card-cat {
    color: var(--accent);
    font-weight: 600;
    text-decoration: none;
  }
  .card-cat:hover {
    text-decoration: underline;
  }
  .read-time {
    color: var(--muted);
  }
  .card-title {
    font-size: 1.35rem;
    font-weight: 700;
    line-height: 1.38;
    margin: 0 0 1rem;
  }
  .card-title a {
    color: var(--text);
    text-decoration: none;
    transition: color 0.15s;
  }
  .card-title a:hover {
    color: var(--accent);
  }
  .card-desc {
    font-size: 0.96rem;
    line-height: 1.6;
    color: var(--muted);
    margin: 0 0 1.75rem;
    flex-grow: 1;
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  .card-footer {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding-top: 1.25rem;
    border-top: 1px solid var(--line);
    font-size: 0.85rem;
  }
  .author-info {
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
  }
  .author-name {
    font-weight: 600;
    color: var(--text);
  }
  .pub-date {
    color: var(--muted);
    font-size: 0.8rem;
  }
  .read-more-link {
    color: var(--accent);
    font-weight: 600;
    text-decoration: none;
    font-size: 0.92rem;
  }
  .read-more-link:hover {
    text-decoration: underline;
  }
</style>
