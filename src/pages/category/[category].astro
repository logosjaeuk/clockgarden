---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

export async function getStaticPaths() {
  const categoryDefs = [
    {
      slug: 'spreadsheet',
      name: '엑셀 & 스프레드시트',
      description: '실무에서 즉시 쓰는 XLOOKUP, INDEX/MATCH, 피벗 테이블, 조건부 서식, 구글 스프레드시트 QUERY 함수 등 데이터 정리와 분석 테크닉을 다룹니다.',
    },
    {
      slug: 'notion',
      name: '노션 & 생산성 앱',
      description: '노션 데이터베이스 관계형(Relation)과 롤업(Rollup), 수식 2.0(Formula 2.0), 맞춤형 올인원 대시보드 설계와 생산성 앱 연동 노하우를 정리합니다.',
    },
    {
      slug: 'templates',
      name: '실무 서식 & 템플릿',
      description: '프로젝트 기획서, 주간 업무일지, 예산안 및 견적서, 회의록 등 실무에서 즉시 복사해 활용할 수 있는 표준 서식 구조와 작성법을 가이드합니다.',
    },
    {
      slug: 'workflow',
      name: '워크플로우 & 단축키',
      description: 'Windows 및 Mac 필수 단축키, 크롬 브라우저 생산성 팁, 반복 업무를 획기적으로 줄여주는 디지털 워크플로우 최적화 루틴을 탐구합니다.',
    },
  ];

  const allArticles = await getCollection('articles');

  return categoryDefs.map((cat) => ({
    params: { category: cat.slug },
    props: {
      categoryInfo: cat,
      articles: allArticles
        .filter((a) => a.data.categorySlug === cat.slug)
        .sort((a, b) => new Date(b.data.pubDate).getTime() - new Date(a.data.pubDate).getTime()),
    },
  }));
}

const { categoryInfo, articles } = Astro.props;
---

<BaseLayout
  title={`${categoryInfo.name} — 스마트 워크 & 실무 도구 가이드`}
  description={categoryInfo.description}
  path={`/category/${categoryInfo.slug}/`}
  locale="ko"
>
  <div class="content-container">
    <nav class="breadcrumb" aria-label="탐색 경로">
      <ol itemscope itemtype="https://schema.org/BreadcrumbList">
        <li itemprop="itemListElement" itemscope itemtype="https://schema.org/ListItem">
          <a itemprop="item" href="/"><span itemprop="name">홈</span></a>
          <meta itemprop="position" content="1" />
        </li>
        <li class="separator">/</li>
        <li itemprop="itemListElement" itemscope itemtype="https://schema.org/ListItem">
          <a itemprop="item" href="/articles/"><span itemprop="name">전체 가이드</span></a>
          <meta itemprop="position" content="2" />
        </li>
        <li class="separator">/</li>
        <li itemprop="itemListElement" itemscope itemtype="https://schema.org/ListItem">
          <span itemprop="name">{categoryInfo.name}</span>
          <meta itemprop="position" content="3" />
        </li>
      </ol>
    </nav>

    <header class="page-header">
      <span class="category-badge">실무 테마 아카이브</span>
      <h1 class="page-title">{categoryInfo.name}</h1>
      <p class="page-subtitle">{categoryInfo.description}</p>
    </header>

    <div class="articles-grid">
      {articles.map((article) => (
        <article class="article-card">
          <div class="card-meta">
            <span class="card-cat">{article.data.category}</span>
            <span class="read-time">{article.data.readTime}분 분량</span>
          </div>

          <h2 class="card-title">
            <a href={`/articles/${article.id}/`}>
              {article.data.title}
            </a>
          </h2>

          <p class="card-desc">
            {article.data.description}
          </p>

          <div class="card-footer">
            <div class="author-info">
              <span class="author-name">{article.data.author}</span>
              <time datetime={article.data.pubDate} class="pub-date">{article.data.pubDate}</time>
            </div>
            <a href={`/articles/${article.id}/`} class="read-more-link" aria-label={`${article.data.title} 전문 읽기`}>
              가이드 보기 &rarr;
            </a>
          </div>
        </article>
      ))}
    </div>
  </div>
</BaseLayout>

<style>
  .content-container {
    max-width: 1120px;
    margin: 0 auto;
    padding: 2.5rem 1.5rem 5rem;
  }

  .breadcrumb {
    margin-bottom: 2rem;
    font-size: 0.875rem;
    color: var(--color-text-muted);
  }

  .breadcrumb ol {
    display: flex;
    align-items: center;
    list-style: none;
    padding: 0;
    margin: 0;
    gap: 0.5rem;
  }

  .breadcrumb a {
    color: var(--color-text-muted);
    text-decoration: none;
    transition: color 0.15s ease;
  }

  .breadcrumb a:hover {
    color: var(--color-accent);
  }

  .separator {
    color: var(--color-border);
  }

  .page-header {
    margin-bottom: 3.5rem;
    padding-bottom: 2rem;
    border-bottom: 1px solid var(--color-border);
  }

  .category-badge {
    display: inline-block;
    font-size: 0.8125rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--color-accent);
    margin-bottom: 0.75rem;
  }

  .page-title {
    font-size: 2.5rem;
    font-weight: 700;
    line-height: 1.2;
    margin: 0 0 1rem;
    color: var(--color-text);
  }

  .page-subtitle {
    font-size: 1.125rem;
    line-height: 1.6;
    color: var(--color-text-muted);
    max-width: 760px;
    margin: 0;
  }

  .articles-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(320px, 1fr));
    gap: 2rem;
  }

  .article-card {
    background: var(--color-bg-card, var(--color-bg-alt));
    border: 1px solid var(--color-border);
    border-radius: 8px;
    padding: 1.75rem;
    display: flex;
    flex-direction: column;
    transition: transform 0.2s ease, box-shadow 0.2s ease, border-color 0.2s ease;
  }

  .article-card:hover {
    transform: translateY(-2px);
    box-shadow: 0 8px 24px rgba(0, 0, 0, 0.06);
    border-color: var(--color-accent);
  }

  .card-meta {
    display: flex;
    justify-content: space-between;
    align-items: center;
    font-size: 0.8125rem;
    color: var(--color-text-muted);
    margin-bottom: 0.75rem;
  }

  .card-cat {
    font-weight: 600;
    color: var(--color-accent);
  }

  .card-title {
    font-size: 1.25rem;
    font-weight: 600;
    line-height: 1.4;
    margin: 0 0 0.875rem;
  }

  .card-title a {
    color: var(--color-text);
    text-decoration: none;
    transition: color 0.15s ease;
  }

  .card-title a:hover {
    color: var(--color-accent);
  }

  .card-desc {
    font-size: 0.9375rem;
    line-height: 1.6;
    color: var(--color-text-muted);
    margin: 0 0 1.5rem;
    flex-grow: 1;
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .card-footer {
    display: flex;
    justify-content: space-between;
    align-items: center;
    font-size: 0.8125rem;
    padding-top: 1rem;
    border-top: 1px solid var(--color-border);
  }

  .author-info {
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
  }

  .author-name {
    font-weight: 500;
    color: var(--color-text);
  }

  .pub-date {
    color: var(--color-text-muted);
  }

  .read-more-link {
    font-weight: 600;
    color: var(--color-accent);
    text-decoration: none;
    display: inline-flex;
    align-items: center;
    gap: 0.25rem;
    transition: gap 0.15s ease;
  }

  .read-more-link:hover {
    gap: 0.5rem;
  }
</style>
