---
import BaseLayout from '../layouts/BaseLayout.astro';
import ClockTool from '../components/ClockTool.astro';
import HomeGuide from '../components/HomeGuide.astro';
import ToolCards from '../components/ToolCards.astro';
---

<BaseLayout
  title="Current Local Time with Seconds and Time Tools"
  description="See your device's current time with seconds, explore Living Clock scenes, or use a stopwatch, countdown, alarm and time zone converter. No account needed."
  path="/"
  tool
>
  <div class="hero-section">
    <ClockTool locale="en" heading="Current local time" />
    <ToolCards locale="en" />
  </div>

  <HomeGuide locale="en" />

  <script>
    import '../scripts/tools';
  </script>
</BaseLayout>
