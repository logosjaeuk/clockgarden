---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

const articles = await getCollection('articles');
const sortedArticles = articles.sort(
  (a, b) => new Date(b.data.pubDate).getTime() - new Date(a.data.pubDate).getTime()
);

const featuredArticle = sortedArticles.find((a) => a.data.featured) || sortedArticles[0];
const recentArticles = sortedArticles.filter((a) => a.id !== featuredArticle?.id).slice(0, 6);

const categories = [
  {
    slug: 'spreadsheet',
    icon: '📊',
    title: '엑셀 & 스프레드시트',
    desc: 'XLOOKUP, INDEX/MATCH, 다중조건 수식, 피벗 테이블 및 데이터 정제 테크닉',
    count: sortedArticles.filter((a) => a.data.categorySlug === 'spreadsheet').length,
  },
  {
    slug: 'notion',
    icon: '📝',
    title: '노션 & 생산성 앱',
    desc: '데이터베이스 관계형(Relation) 모델링, 수식 2.0, 올인원 워크스페이스 대시보드',
    count: sortedArticles.filter((a) => a.data.categorySlug === 'notion').length,
  },
  {
    slug: 'templates',
    icon: '📋',
    title: '실무 서식 & 템플릿',
    desc: '프로젝트 기획서, 주간 업무보고, 예산 견적서, 회의록 등 검증된 표준 비즈니스 양식',
    count: sortedArticles.filter((a) => a.data.categorySlug === 'templates').length,
  },
  {
    slug: 'workflow',
    icon: '⚡',
    title: '워크플로우 & 단축키',
    desc: 'Windows/Mac 필수 단축키, 크롬 생산성 확장 도구, 반복 업무 축소 자동화 루틴',
    count: sortedArticles.filter((a) => a.data.categorySlug === 'workflow').length,
  },
];
---

<BaseLayout
  title="클락가든 — 스마트 워크 & 실무 도구 가이드"
  description="직장인과 프리랜서의 소중한 시간을 절약해주는 스마트 워크 실무 지식 아카이브. 엑셀, 스프레드시트, 노션, 실무 서식 및 자동화 단축키 가이드를 다룹니다."
  path="/"
  locale="ko"
>
  <div class="home-container">
    <!-- Hero Banner -->
    <section class="hero-banner">
      <div class="hero-badge">Smart Work Field Guide & Productivity Lab</div>
      <h1 class="hero-title">
        반복적인 수작업을 줄이고,<br />
        <span class="gradient-text">본질적인 일에 집중하세요</span>
      </h1>
      <p class="hero-sub">
        클락가든(Clock Garden)은 직장인과 프리랜서의 소중한 시간을 아껴주는 스마트 워크 지식 아카이브입니다.
        실무에서 검증된 엑셀 고급 수식, 노션 데이터베이스 모델링, 표준 업무 서식과 생산성 워크플로우를 체계적으로 정리합니다.
      </p>

      <div class="hero-search-bar">
        <a href="/articles/" class="btn-primary">전체 실무 가이드 탐색 ({sortedArticles.length}편) &rarr;</a>
        <a href="/category/spreadsheet/" class="btn-secondary">엑셀 수식 바로가기</a>
      </div>
    </section>

    <!-- Bento Categories Grid -->
    <section class="bento-section">
      <div class="section-header">
        <span class="sub-label">CORE DOMAINS</span>
        <h2>핵심 실무 4대 카테고리</h2>
        <p>현업에서 매일 마주하는 비효율을 해결하기 위한 4가지 집중 영역입니다.</p>
      </div>

      <div class="bento-grid">
        {categories.map((cat) => (
          <a href={`/category/${cat.slug}/`} class="bento-card">
            <div class="bento-icon">{cat.icon}</div>
            <div class="bento-body">
              <div class="bento-top">
                <span class="bento-count">{cat.count}개의 심층 가이드</span>
              </div>
              <h3 class="bento-title">{cat.title}</h3>
              <p class="bento-desc">{cat.desc}</p>
            </div>
            <div class="bento-arrow">탐색 &rarr;</div>
          </a>
        ))}
      </div>
    </section>

    {featuredArticle && (
      <section class="featured-section">
        <div class="featured-card">
          <div class="featured-badge">추천 실무 가이드</div>
          <span class="featured-cat">{featuredArticle.data.category}</span>
          <h2 class="featured-title">
            <a href={`/articles/${featuredArticle.id}/`}>{featuredArticle.data.title}</a>
          </h2>
          <p class="featured-desc">{featuredArticle.data.description}</p>
          <div class="featured-meta">
            <span class="author">{featuredArticle.data.author} ({featuredArticle.data.authorRole})</span>
            <span class="dot">·</span>
            <time datetime={featuredArticle.data.pubDate}>{featuredArticle.data.pubDate}</time>
            <span class="dot">·</span>
            <span>{featuredArticle.data.readTime}분 완독</span>
          </div>
          <div class="featured-action">
            <a href={`/articles/${featuredArticle.id}/`} class="btn-primary">가이드 전문 읽기 &rarr;</a>
          </div>
        </div>
      </section>
    )}

    <!-- Recent Guides Grid -->
    <section class="recent-section">
      <div class="section-header-flex">
        <div>
          <span class="sub-label">RECENT GUIDES</span>
          <h2>최신 실무 가이드</h2>
        </div>
        <a href="/articles/" class="view-all-link">전체 보기 &rarr;</a>
      </div>

      <div class="articles-grid">
        {recentArticles.map((article) => (
          <article class="article-card">
            <div class="card-meta">
              <a href={`/category/${article.data.categorySlug}/`} class="card-cat">
                {article.data.category}
              </a>
              <span class="read-time">{article.data.readTime}분 완독</span>
            </div>

            <h3 class="card-title">
              <a href={`/articles/${article.id}/`}>{article.data.title}</a>
            </h3>

            <p class="card-desc">{article.data.description}</p>

            <div class="card-footer">
              <span class="pub-date">{article.data.pubDate}</span>
              <a href={`/articles/${article.id}/`} class="read-more">보기 &rarr;</a>
            </div>
          </article>
        ))}
      </div>
    </section>

    <!-- Productivity Callout Section -->
    <section class="callout-section">
      <div class="callout-inner">
        <div class="callout-content">
          <h3>수식 오류가 발생하거나 원하는 템플릿이 필요하신가요?</h3>
          <p>
            클락가든 연구팀은 독자 여러분의 실무 환경에서 발생하는 병목 현상을 해결해 드립니다.
            문의 창구를 통해 개선이 필요한 업무 루틴이나 복잡한 엑셀 수식을 남겨주세요.
          </p>
        </div>
        <a href="/contact/" class="btn-primary">연구팀에 질문 / 요청하기 &rarr;</a>
      </div>
    </section>
  </div>
</BaseLayout>

<style>
  .home-container {
    max-width: 1120px;
    margin: 0 auto;
    padding: 3rem 1.5rem 6rem;
  }

  .hero-banner {
    text-align: center;
    padding: 3rem 0 4.5rem;
    border-bottom: 1px solid var(--color-border);
  }

  .hero-badge {
    display: inline-block;
    padding: 0.35rem 0.85rem;
    border-radius: 9999px;
    background: var(--color-bg-alt);
    border: 1px solid var(--color-border);
    font-size: 0.8125rem;
    font-weight: 600;
    color: var(--color-accent);
    letter-spacing: 0.04em;
    margin-bottom: 1.5rem;
  }

  .hero-title {
    font-size: 2.75rem;
    font-weight: 800;
    line-height: 1.25;
    letter-spacing: -0.02em;
    margin: 0 0 1.25rem;
    color: var(--color-text);
  }

  .gradient-text {
    background: linear-gradient(135deg, var(--color-accent) 0%, #2563eb 100%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
  }

  .hero-sub {
    font-size: 1.125rem;
    line-height: 1.7;
    color: var(--color-text-muted);
    max-width: 720px;
    margin: 0 auto 2rem;
  }

  .hero-search-bar {
    display: flex;
    justify-content: center;
    gap: 1rem;
    flex-wrap: wrap;
  }

  .btn-primary {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    background: var(--color-accent);
    color: #fff;
    padding: 0.75rem 1.5rem;
    border-radius: 6px;
    font-weight: 600;
    text-decoration: none;
    transition: opacity 0.15s ease, transform 0.15s ease;
  }

  .btn-primary:hover {
    opacity: 0.92;
    transform: translateY(-1px);
  }

  .btn-secondary {
    display: inline-flex;
    align-items: center;
    background: var(--color-bg-card, var(--color-bg-alt));
    border: 1px solid var(--color-border);
    color: var(--color-text);
    padding: 0.75rem 1.5rem;
    border-radius: 6px;
    font-weight: 600;
    text-decoration: none;
    transition: border-color 0.15s ease;
  }

  .btn-secondary:hover {
    border-color: var(--color-accent);
    color: var(--color-accent);
  }

  /* Bento Grid */
  .bento-section {
    padding: 4rem 0 3rem;
  }

  .section-header {
    margin-bottom: 2.5rem;
  }

  .sub-label {
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    color: var(--color-accent);
    text-transform: uppercase;
    display: block;
    margin-bottom: 0.5rem;
  }

  .section-header h2 {
    font-size: 1.875rem;
    font-weight: 700;
    margin: 0 0 0.5rem;
    color: var(--color-text);
  }

  .section-header p {
    color: var(--color-text-muted);
    font-size: 1rem;
    margin: 0;
  }

  .bento-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
    gap: 1.5rem;
  }

  .bento-card {
    background: var(--color-bg-card, var(--color-bg-alt));
    border: 1px solid var(--color-border);
    border-radius: 10px;
    padding: 1.75rem;
    text-decoration: none;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    transition: all 0.2s ease;
  }

  .bento-card:hover {
    transform: translateY(-3px);
    border-color: var(--color-accent);
    box-shadow: 0 10px 30px rgba(0, 0, 0, 0.05);
  }

  .bento-icon {
    font-size: 2rem;
    margin-bottom: 1rem;
  }

  .bento-top {
    margin-bottom: 0.5rem;
  }

  .bento-count {
    font-size: 0.75rem;
    font-weight: 600;
    color: var(--color-text-muted);
  }

  .bento-title {
    font-size: 1.25rem;
    font-weight: 700;
    color: var(--color-text);
    margin: 0 0 0.5rem;
  }

  .bento-desc {
    font-size: 0.875rem;
    line-height: 1.6;
    color: var(--color-text-muted);
    margin: 0 0 1.5rem;
  }

  .bento-arrow {
    font-size: 0.875rem;
    font-weight: 600;
    color: var(--color-accent);
    display: flex;
    align-items: center;
    gap: 0.25rem;
  }

  /* Featured Section */
  .featured-section {
    margin: 2rem 0 4rem;
  }

  .featured-card {
    background: var(--color-bg-card, var(--color-bg-alt));
    border: 1px solid var(--color-border);
    border-radius: 12px;
    padding: 2.5rem;
    position: relative;
    border-left: 4px solid var(--color-accent);
  }

  .featured-badge {
    display: inline-block;
    font-size: 0.75rem;
    font-weight: 700;
    text-transform: uppercase;
    background: var(--color-accent);
    color: #fff;
    padding: 0.2rem 0.6rem;
    border-radius: 4px;
    margin-bottom: 1rem;
  }

  .featured-cat {
    display: block;
    font-size: 0.8125rem;
    font-weight: 600;
    color: var(--color-accent);
    margin-bottom: 0.5rem;
  }

  .featured-title {
    font-size: 1.875rem;
    font-weight: 700;
    line-height: 1.3;
    margin: 0 0 1rem;
  }

  .featured-title a {
    color: var(--color-text);
    text-decoration: none;
  }

  .featured-title a:hover {
    color: var(--color-accent);
  }

  .featured-desc {
    font-size: 1.0625rem;
    line-height: 1.7;
    color: var(--color-text-muted);
    margin: 0 0 1.5rem;
    max-width: 840px;
  }

  .featured-meta {
    font-size: 0.875rem;
    color: var(--color-text-muted);
    display: flex;
    align-items: center;
    gap: 0.5rem;
    margin-bottom: 1.5rem;
    flex-wrap: wrap;
  }

  .featured-meta .dot {
    opacity: 0.4;
  }

  /* Recent Section */
  .recent-section {
    padding: 2rem 0 4rem;
  }

  .section-header-flex {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    margin-bottom: 2rem;
  }

  .section-header-flex h2 {
    font-size: 1.75rem;
    font-weight: 700;
    margin: 0;
    color: var(--color-text);
  }

  .view-all-link {
    font-size: 0.9375rem;
    font-weight: 600;
    color: var(--color-accent);
    text-decoration: none;
  }

  .articles-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(320px, 1fr));
    gap: 2rem;
  }

  .article-card {
    background: var(--color-bg-card, var(--color-bg-alt));
    border: 1px solid var(--color-border);
    border-radius: 8px;
    padding: 1.75rem;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    transition: all 0.2s ease;
  }

  .article-card:hover {
    transform: translateY(-2px);
    box-shadow: 0 8px 24px rgba(0, 0, 0, 0.06);
    border-color: var(--color-accent);
  }

  .card-meta {
    display: flex;
    justify-content: space-between;
    align-items: center;
    font-size: 0.8125rem;
    margin-bottom: 0.75rem;
  }

  .card-cat {
    font-weight: 600;
    color: var(--color-accent);
    text-decoration: none;
  }

  .read-time {
    color: var(--color-text-muted);
  }

  .card-title {
    font-size: 1.25rem;
    font-weight: 600;
    line-height: 1.4;
    margin: 0 0 0.875rem;
  }

  .card-title a {
    color: var(--color-text);
    text-decoration: none;
  }

  .card-title a:hover {
    color: var(--color-accent);
  }

  .card-desc {
    font-size: 0.9375rem;
    line-height: 1.6;
    color: var(--color-text-muted);
    margin: 0 0 1.5rem;
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .card-footer {
    display: flex;
    justify-content: space-between;
    align-items: center;
    font-size: 0.8125rem;
    padding-top: 1rem;
    border-top: 1px solid var(--color-border);
  }

  .pub-date {
    color: var(--color-text-muted);
  }

  .read-more {
    font-weight: 600;
    color: var(--color-accent);
    text-decoration: none;
  }

  /* Callout Section */
  .callout-section {
    background: var(--color-bg-card, var(--color-bg-alt));
    border: 1px solid var(--color-border);
    border-radius: 12px;
    padding: 2.5rem;
  }

  .callout-inner {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 2rem;
    flex-wrap: wrap;
  }

  .callout-content h3 {
    font-size: 1.375rem;
    font-weight: 700;
    margin: 0 0 0.5rem;
    color: var(--color-text);
  }

  .callout-content p {
    font-size: 0.9375rem;
    line-height: 1.6;
    color: var(--color-text-muted);
    margin: 0;
    max-width: 650px;
  }

  @media (max-width: 768px) {
    .hero-title {
      font-size: 2.125rem;
    }
    .featured-title {
      font-size: 1.5rem;
    }
  }
</style>
