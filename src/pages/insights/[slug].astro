---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { articles, articleSlugs, type ArticleCopy } from '../../content/insights';
import { pathFor } from '../../i18n';

export function getStaticPaths() {
  return articleSlugs.map((slug) => ({
    params: { slug },
    props: { article: articles.en[slug] },
  }));
}

interface Props {
  article: ArticleCopy;
}

const { article } = Astro.props;

const toolNames: Record<string, string> = {
  clock: 'Online Clock & Ambient Display',
  stopwatch: 'Online Precision Stopwatch',
  timer: 'Countdown & Focus Timer',
  alarm: 'Online Alarm Clock',
  'world-clock': 'World Clock & Meeting Planner',
  'time-zone-converter': 'Time Zone Converter',
};

const toolName = toolNames[article.relatedTool] || 'Clock Garden Tool';

const articleSchema = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: article.title,
  description: article.description,
  datePublished: article.publishedDate,
  author: {
    '@type': 'Organization',
    name: 'Clock Garden Editorial Team',
    url: 'https://clockgarden.com/about/',
  },
  publisher: {
    '@type': 'Organization',
    name: 'Clock Garden',
    url: 'https://clockgarden.com',
  },
};
---

<BaseLayout
  title={article.title}
  description={article.description}
  path={`/insights/${article.slug}/`}
>
  <script
    slot="head"
    is:inline
    type="application/ld+json"
    set:html={JSON.stringify(articleSchema)}
  />

  <article class="article-page">
    <a class="article-nav-back" href="/insights/">
      <span aria-hidden="true">&larr;</span> Back to Insights Hub
    </a>

    <header class="article-header">
      <div class="insight-badge-row">
        <span class="insight-badge">{article.category}</span>
        <span class="insight-time">{article.readTimeMinutes} min read</span>
      </div>
      <h1>{article.title}</h1>
      <div class="article-meta-row">
        <span>By Clock Garden Research</span>
        <span aria-hidden="true">&bull;</span>
        <time datetime={article.publishedDate}>{article.publishedDate}</time>
      </div>
    </header>

    <div class="article-lead">
      {article.heroLead}
    </div>

    <div class="article-body">
      {
        article.sections.map((section) => (
          <section class="article-section">
            <h2>{section.heading}</h2>
            {section.paragraphs.map((p) => (
              <p>{p}</p>
            ))}
            {section.callout && (
              <aside class="article-callout" role="note">
                <strong>Key Insight: </strong> {section.callout}
              </aside>
            )}
          </section>
        ))
      }
    </div>

    <section class="article-takeaways" aria-labelledby="takeaways-title">
      <h3 id="takeaways-title">Key Takeaways &amp; Practical Advice</h3>
      <ul>
        {article.takeaways.map((item) => (
          <li>{item}</li>
        ))}
      </ul>
    </section>

    <aside class="article-tool-cta">
      <div class="article-tool-cta-text">
        <h4>Put This Into Practice: {toolName}</h4>
        <p>Run our privacy-first, sub-millisecond precision instrument directly in your browser.</p>
      </div>
      <a class="article-tool-btn" href={`/${article.relatedTool}/`}>
        Open {toolName} &rarr;
      </a>
    </aside>
  </article>
</BaseLayout>
