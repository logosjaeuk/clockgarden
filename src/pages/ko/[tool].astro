---
import GenericToolPage from '../../components/GenericToolPage.astro';
import { toolPages, type ToolKey } from '../../content/toolPages';
export function getStaticPaths() {
  return Object.keys(toolPages.ko).map((tool) => ({ params: { tool }, props: { tool } }));
}
const { tool } = Astro.props as { tool: ToolKey };
---

<GenericToolPage locale="ko" tool={tool} />
