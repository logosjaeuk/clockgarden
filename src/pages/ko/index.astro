---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ClockTool from '../../components/ClockTool.astro';
import HomeGuide from '../../components/HomeGuide.astro';
import ToolCards from '../../components/ToolCards.astro';
---

<BaseLayout
  title="초 단위 현재 시간과 온라인 시간 도구"
  description="기기의 현재 시간을 초 단위로 확인하세요. Living Clock 풍경, 스톱워치, 타이머, 알람, 세계 시계와 시간대 변환기를 회원가입 없이 사용합니다."
  locale="ko"
  path="/"
  tool
>
  <div class="hero-section">
    <ClockTool locale="ko" heading="현재 현지 시간" />
    <ToolCards locale="ko" />
  </div>

  <HomeGuide locale="ko" />

  <script>
    import '../../scripts/tools';
  </script>
</BaseLayout>
