---
import ArticlePage from '../../../components/ArticlePage.astro';
import { articles, articleSlugs } from '../../../content/insights';
export function getStaticPaths() {
  return articleSlugs.map((slug) => ({ params: { slug }, props: { article: articles.ko[slug] } }));
}
const { article } = Astro.props;
---

<ArticlePage article={article} locale="ko" />
