---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { articles, articleSlugs } from '../../../content/insights';

const list = articleSlugs.map((slug) => articles.ko[slug]);
---

<BaseLayout
  title="Clock Garden 사용 안내 – 시계, 타이머와 시간대"
  description="타이머의 제약, 해외 회의 시차, 화면 설정, Living Clock 제작 방식을 예시와 함께 확인하세요."
  locale="ko"
  path="/insights/"
>
  <div class="insights-page">
    <header class="insights-header">
      <p class="eyebrow">실용적인 도구 안내</p>
      <h1>시간 도구 사용 안내</h1>
      <p class="insights-lead">
        도구 사용법을 익히고 예시를 따라 해 보세요. 알림을 사용하기 전 브라우저 제약도 확인할 수
        있습니다.
      </p>
    </header>

    <div class="insights-grid">
      {
        list.map((art) => (
          <article class="insight-card">
            <div class="insight-badge-row">
              <span class="insight-badge">{art.category}</span>
              <span class="insight-time">{art.readTimeMinutes}분 분량</span>
            </div>
            <h2>
              <a href={`/ko/insights/${art.slug}/`}>{art.title}</a>
            </h2>
            <p class="insight-desc">{art.description}</p>
            <div class="insight-footer">
              <time class="insight-date" datetime={art.publishedDate}>
                {art.publishedDate}
              </time>
              <a class="insight-cta" href={`/ko/insights/${art.slug}/`}>
                가이드 읽기 <span aria-hidden="true">&rarr;</span>
              </a>
            </div>
          </article>
        ))
      }
    </div>
  </div>
</BaseLayout>
